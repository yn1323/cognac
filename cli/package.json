{
  "name": "@yn1323/cognac",
  "version": "0.1.0",
  "description": "AI駆動のタスク自動実行ツール",
  "type": "module",
  "bin": {
    "cognac": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured yet'",
    "test": "echo 'no tests yet'"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "commander": "^12.1.0",
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@cognac/client": "workspace:*",
    "@cognac/server": "workspace:*",
    "@cognac/shared": "workspace:*",
    "@hono/node-server": "^1.13.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
